{
  "name": "@agentix-e/db-operations",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "for pkg in core auth audit backup health logger maintenance metrics monitor observability security; do tsc -p \"packages/$pkg/tsconfig.json\"; done",
    "build:clean": "rm -rf packages/*/dist",
    "build:watch": "tsc -b --watch",
    "clean": "rm -rf packages/*/dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'packages/*/src/**/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
