{
  "name": "@agentix-e/db-operations",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "for pkg in core auth audit backup health logger maintenance metrics monitor observability security; do tsc -p \"packages/$pkg/tsconfig.json\"; done",
    "build:clean": "rm -rf packages/*/dist",
    "build:watch": "tsc -b --watch",
    "clean": "rm -rf packages/*/dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "bench": "tsx bench/run-all.ts",
    "bench:ycsb": "tsx bench/ycsb/run-ycsb.ts",
    "docs": "typedoc",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "coverage": "vitest run --coverage",
    "ci": "npx tsc --noEmit && npm run test && npm run coverage"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/db-operations.git"
  },
  "description": "Unified, engine-agnostic database operations framework — 20 packages, 866 tests",
  "keywords": [
    "database",
    "operations",
    "backup",
    "monitoring",
    "security",
    "audit",
    "metrics",
    "observability"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
