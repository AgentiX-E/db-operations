{
  "name": "@agentix-e/db-operations-backup",
  "version": "0.1.0",
  "description": "Backup and PITR abstractions for db-operations",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentix-e/db-operations-core": "^0.1.0",
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/lib-storage": "^3.1095.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
